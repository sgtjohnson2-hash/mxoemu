+SelfVitalsMsg::SelfVitalsMsg( PlayerObject *thePlayer, bool includeMax, bool includeDead )
+{
+	m_buf.clear();
+	if (thePlayer == NULL)
+		throw PacketNoLongerValid();
+
+	AttributeUpdateBlock block;
+	block.addUInt16(PlayerAttrSelf::InnerStrengthAvailable,thePlayer->getCurrentIS());
+	block.addUInt16(PlayerAttrSelf::Health,thePlayer->getCurrentHealth());
+	if (includeMax)
+	{
+		block.addUInt16(PlayerAttrSelf::MaxHealth,thePlayer->getMaximumHealth());
+		block.addUInt16(PlayerAttrSelf::InnerStrengthMax,thePlayer->getMaximumIS());
+		block.addByte(PlayerAttrSelf::Level,thePlayer->getLevel());
+	}
+	if (includeDead)
+		block.addByte(PlayerAttrSelf::IsDead,thePlayer->isDead() ? 1 : 0);
+
+	m_buf << uint8(0x03);
+	m_buf << uint16(VIEWID_SELF);
+	ByteBuffer blockBuf = block.toBuf(false); //self view updates carry no count byte
+	m_buf.append(blockBuf.contents(),blockBuf.size());
+}
