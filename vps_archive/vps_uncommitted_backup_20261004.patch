+// ---------------------------------------------------------------------------
+// combat / view attribute update messages
+// ---------------------------------------------------------------------------
+
+#include "GOAttributes.h"
+
+HealthUpdateMsg::HealthUpdateMsg( uint32 objectId, bool includeMax, bool includeDead )
+	:ObjectUpdateMsg(objectId),m_includeMax(includeMax),m_includeDead(includeDead)
+{
+}
+
+HealthUpdateMsg::~HealthUpdateMsg()
+{
+}
+
+const ByteBuffer& HealthUpdateMsg::toBuf()
+{
+	m_buf.clear();
+
+	PlayerObject *m_player = NULL;
+	m_player = sObjMgr.getGOPtr(m_objectId);
+	if (m_player == NULL)
+	{
+		throw PacketNoLongerValid();
+	}
+	uint16 viewId = 0;
+	try
+	{
+		viewId = sObjMgr.getViewForGO(m_toWho,m_objectId);
+	}
+	catch (ObjectMgr::ClientNotAvailable)
+	{
+		throw PacketNoLongerValid();
+	}
+
+	AttributeUpdateBlock block;
+	block.addUInt16(PlayerAttrOther::Health,m_player->getCurrentHealth());
+	if (m_includeMax)
+		block.addUInt16(PlayerAttrOther::MaxHealth,m_player->getMaximumHealth());
+	if (m_includeDead)
+		block.addByte(PlayerAttrOther::IsDead,m_player->isDead() ? 1 : 0);
+
+	m_buf << uint8(0x03);
+	m_buf << uint16(viewId);
+	ByteBuffer blockBuf = block.toBuf(true);
+	m_buf.append(blockBuf.contents(),blockBuf.size());
+	return m_buf;
+}
