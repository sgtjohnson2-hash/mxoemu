-        commander.EvaluateFrontlines(m_districtStatus, m_controlNodes, now);
-
-        uint32 targetNode = commander.GetPreferredTargetNode();
-        if (targetNode != 0 && commander.GetWarSupply() >= 50) {
-            // Count active squads for this faction
