+			bot->SetTargetGoId(partnerGoId);
+		}
+	}
+	else
+	{
+		m_parent.QueueCommand(shared_ptr<SystemChatMsg>(new SystemChatMsg(
+			"{c:FF8800}You are now in Interlock. Tactics: &tactic speed|power|grab|block - withdraw with &withdraw{/c}")));
+	}
+}
