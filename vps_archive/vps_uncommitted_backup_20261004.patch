-void FactionWarManager::registerControlNode(uint32 id, uint32 districtId, float x, float y, float z)
-{
-    ControlNode node;
-    node.id = id;
-    node.districtId = (districtId == 0) ? 1 : districtId;
-    node.x = x;
-    node.y = y;
-    node.z = z;
-    node.controllingFaction = FACTION_MACHINES; // Default to Machines
