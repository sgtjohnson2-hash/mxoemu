+void PlayerObject::enterInterlock( uint32 partnerGoId )
+{
+	m_ilPartner = partnerGoId;
+	m_inCombat = true;
+	setCombatStance(true);
+	if (m_parent.isBot())
+	{
+		BotClient* bot = dynamic_cast<BotClient*>(&m_parent);
